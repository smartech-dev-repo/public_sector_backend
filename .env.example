NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins, e.g.
# https://admin.example.com,https://app.example.com
# Use * to allow any origin. Leave unset/empty to disable CORS entirely.
CORS_ORIGINS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/public_sector_backend?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
BOOTSTRAP_ADMIN_NAME=Super Admin
OTP_TTL_SECONDS=300

# STORAGE_PROVIDER selects the active FileStorageProvider: local | s3 | gcs
# Only the selected provider's variables need real values.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

GCP_BUCKET_NAME=
# Local dev: path to a service-account JSON key file (never commit the
# file itself, and never paste its contents into chat/logs — treat it as
# a live secret).
GCP_CREDENTIALS_FILE=./gcp-credentials.json
# Deployment platforms with no file mount (e.g. Dokploy): paste the key
# file's raw JSON contents as this single env var instead. Only one of
# GCP_CREDENTIALS_FILE / GCP_CREDENTIALS_JSON is needed — FILE wins if
# both are set.
GCP_CREDENTIALS_JSON=
# Optional key prefix within the bucket, e.g. for sharing one bucket across
# multiple apps/environments without their object keys colliding.
GCP_SUB_PATH=

REDIS_URL=redis://localhost:6379
# Must be unique to this app on whatever Redis instance REDIS_URL points to.
# A shared Redis instance (e.g. one UAT box hosting several apps) means a
# collision here has another app's BullMQ workers stealing this app's jobs
# (and vice versa) whenever a queue name matches - use an app-specific
# prefix, never a generic default, on any shared instance.
#
# This also applies to local dev vs. a deployed instance of THIS SAME app:
# if a UAT/staging deployment already exists on the shared Redis, your local
# .env needs its own distinct prefix (e.g. append "-local-dev") or your
# local test runs and that deployment will steal each other's queue jobs -
# hit this exact bug once already (see git history around 2026-09-16).
REDIS_KEY_PREFIX=bull

# mock | dojah — mock is the safe default; never mixes with dojah in the
# same active list (a real-vendor outage must never silently fall back to
# fabricated identity data).
IDENTITY_VERIFICATION_PROVIDER=mock
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# https://sandbox.dojah.io for testing, https://api.dojah.io for production
DOJAH_BASE_URL=https://sandbox.dojah.io

# Provisional placeholder — the real ratio will be supplied later.
LOAN_SALARY_MULTIPLE_CAP=3

# Optional — if unset, the approval/resend-credentials email simply omits
# the app download line.
AGENT_APP_DOWNLOAD_URL=

# Set to false in this repo's own dev/test config -- almost every e2e test
# calls admin login in beforeAll, which would otherwise blow past both
# limits within minutes of a full suite run. A dedicated, isolated e2e
# test forces this to true just for itself to prove the mechanism works.
RATE_LIMITING_ENABLED=false
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_DEFAULT_TTL_SECONDS=60
